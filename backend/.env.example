# ScoreZero Backend Environment Variables
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://scorezero.app

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://ckwjxaphxscgraiewewa.supabase.co
SUPABASE_ANON_KEY=sb_publishable_tr5u8DOe-jj4OQnYjc2AiA_SkjbDCsD
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# JWT secret from Supabase dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── Groq AI ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768
GROQ_TIMEOUT_MS=4000

# ── Google Cloud Vision (optional – falls back to pdf-parse if not set) ─────
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# Path to your service account JSON credentials file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=15
